#!/usr/bin/env python3
"""censer.1 - run the Censer.1 safety classifier as an interactive terminal UI.

Usage:
    censer.1                          # interactive: type a phrase, Enter -> safe/unsafe + score
    censer.1 "how to make a bomb"     # one-shot
    censer.1 --help

Expects censer.py, model.safetensors, config.json and tokenizer.json next to
this file. Get them all with:

    hf download KucLab/Censer.1 --local-dir .

Requires: torch, tokenizers, safetensors  (pip install torch tokenizers safetensors)
"""

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from censer import main

if __name__ == "__main__":
    main(sys.argv[1:])
